# ── VIVE-IA en Hostinger (hosting compartido, LiteSpeed) ────────────────────
# Config real de producción: LiteSpeed lee este archivo (Apache también).
# Equivale a nginx.conf (que queda para el VPS de DigitalOcean como respaldo):
# si cambiás headers o la CSP acá, cambialos también allá.

Options -Indexes
# Las barras finales las resolvemos abajo con un solo 301 a https (DirectorySlash
# redirige sin saber si la conexión era https y suma un salto)
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── 1. Siempre HTTPS y sin www, en un solo salto ────────────────────────────
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # ── 2. Archivos ocultos: 404 (no 403), salvo /.well-known/ (RFC 8615) ───────
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [R=404,L]

  # ── 3. /soluciones no tiene contenido: directo a e-commerce ─────────────────
  RewriteRule ^soluciones/?$ https://%{HTTP_HOST}/soluciones/ecommerce/ [R=301,L]

  # ── 4. Markdown for Agents ──────────────────────────────────────────────────
  # Con "Accept: text/markdown" se sirve el .md generado en el build
  # (scripts/generate-markdown.mjs) en vez del HTML.
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^$ /index.md [L]
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^(contacto|desarrollos|quienes-somos)/?$ /$1.md [L]
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^soluciones/(ecommerce|mentores-marcas-personales)/?$ /soluciones/$1.md [L]

  # ── 5. Barra final: /contacto → https://…/contacto/ (la URL canónica) ───────
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # ── 6. Marca del home para el Link header de agent discovery ────────────────
  RewriteRule ^(index\.html)?$ - [E=IS_HOMEPAGE:1]
</IfModule>

DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType text/markdown;charset=utf-8 .md
  AddType text/plain;charset=utf-8 .txt
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  # ── Seguridad (todas las respuestas) ────────────────────────────────────────
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always unset X-Powered-By

  # CSP. 'unsafe-inline' en script-src por los <script type="application/ld+json">:
  # Chrome los evalúa contra script-src y sin esto se rompe el render (ver CLAUDE.md).
  # Son contenido estático, sin datos de usuario. AOS, Three.js e Inter salen del
  # propio sitio (sin cdnjs ni Google Fonts). Los videos van por youtube-nocookie.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self'; frame-src https://www.youtube-nocookie.com; connect-src 'self' https://n8n.vive-ia.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Agent discovery: solo en el home
  Header always set Link "</llms.txt>; rel=service-doc" env=IS_HOMEPAGE
  Header always set Link "</llms.txt>; rel=service-doc" env=REDIRECT_IS_HOMEPAGE

  # ── Caché ───────────────────────────────────────────────────────────────────
  # Todos los .js y .css salen de /_astro/ con hash en el nombre: se pueden cachear un año
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|svg|gif|ico|mp4|webm|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|md|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compresión (LiteSpeed comprime en brotli por su cuenta; esto cubre Apache) ─
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/markdown text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
