---
import { imgSize } from '../../lib/imageSize';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import MetricCounter from '../../components/MetricCounter.astro';
import HeroFlow from '../../components/HeroFlow.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import VideoDialog from '../../components/VideoDialog.astro';

const problemas = [
  {
    image: '/images/carrito-abandonado.webp',
    title: 'Carritos abandonados',
    description: 'El 70% de tus clientes potenciales se van sin comprar por falta de asistencia inmediata.',
  },
  {
    image: '/images/tareas-manuales.webp',
    title: 'Tareas manuales',
    description: 'Tu equipo pierde horas respondiendo "¿dónde está mi pedido?" o "¿tienen stock?".',
  },
  {
    image: '/images/baja-retencion.webp',
    title: 'Baja retención',
    description: 'Sin un seguimiento post-venta personalizado, los clientes rara vez vuelven a comprar.',
  },
  {
    image: '/images/falta-integracion.webp',
    title: 'Falta de integración',
    description: 'Tus sistemas no hablan entre sí, causando fricción en el proceso de compra.',
  },
  {
    image: '/images/soporte-lento.webp',
    title: 'Soporte lento',
    description: 'Tiempos de respuesta superiores a 2 horas matan la intención de compra del usuario.',
  },
  {
    image: '/images/escalabilidad.webp',
    title: 'Escalabilidad nula',
    description: 'En épocas de alta demanda (Hot Sale, Navidad), tu equipo colapsa y perdés ventas.',
  },
];

const capacidades = [
  {
    title: 'Atención Instantánea 24/7',
    description: 'Respuestas en menos de 3 segundos, siempre disponible.',
  },
  {
    title: 'Venta Sugestiva Inteligente',
    description: 'Recomienda productos basados en el comportamiento del usuario.',
  },
  {
    title: 'Gestión de Logística Automática',
    description: 'Rastreo de pedidos e incidencias sin intervención humana.',
  },
];

const beneficios = [
  {
    image: '/images/escala.webp',
    title: 'Escala masiva',
    description: 'Atendé a 1 o 10.000 personas al mismo tiempo sin degradar la calidad.',
  },
  {
    image: '/images/data-analisis.webp',
    title: 'Data Analytics',
    description: 'Descubrí por qué tus clientes no compran y optimizá tu catálogo con insights reales.',
  },
  {
    image: '/images/multilenguaje.webp',
    title: 'Multilenguaje',
    description: 'Vendé en cualquier mercado. Tu agente habla más de 50 idiomas con fluidez.',
  },
  {
    image: '/images/omnicanalidad.webp',
    title: 'Omnicanalidad',
    description: 'Mismo cerebro en WhatsApp, Instagram, Web y Facebook Messenger.',
  },
  {
    image: '/images/seguridad.webp',
    title: 'Seguridad garantizada',
    description: 'Tratamiento de datos personales bajo los más altos estándares internacionales.',
  },
  {
    image: '/images/setup.webp',
    title: 'Setup Rápido',
    description: 'Implementación en menos de 15 días con entrenamiento personalizado.',
  },
];

// "Armá tu agente": mismas funciones que antes estaban repartidas en los planes
const plataformas = ['Tienda Nube', 'Shopify', 'WooCommerce', 'MercadoShops', 'Otra plataforma'];

// Íconos: trazos de Lucide (constantes del propio sitio, por eso van con set:html)
const funciones = [
  {
    title: 'Consultas de productos, envíos y pagos',
    desc: 'Responde al instante sobre productos, envíos y medios de pago.',
    msg: 'responda consultas de productos, envíos y medios de pago',
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  },
  {
    title: 'Recomendación de productos',
    desc: 'Asesora y sugiere productos según lo que busca cada cliente.',
    msg: 'asesore y recomiende productos a cada cliente',
    icon: '<path d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2z"/>',
  },
  {
    title: 'Recuperación de carritos',
    desc: 'Le escribe a quien dejó el carrito para ayudarlo a terminar la compra.',
    msg: 'recupere carritos abandonados',
    icon: '<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>',
  },
  {
    title: 'Post-compra y recompra',
    desc: 'Embudos post-compra y remarketing para que vuelvan a comprar.',
    msg: 'haga seguimiento post-compra y remarketing',
    icon: '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  },
  {
    title: 'Calificación de clientes',
    desc: 'Detecta el interés de cada cliente y los segmenta.',
    msg: 'califique y segmente clientes',
    icon: '<path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>',
  },
  {
    title: 'Derivación a tu equipo',
    desc: 'Pasa la conversación a una persona cuando hace falta.',
    msg: 'derive a una persona de mi equipo cuando haga falta',
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
  {
    title: 'Reportes de conversaciones y ventas',
    desc: 'Reportes de interacción y conversión para decidir con datos.',
    msg: 'genere reportes de interacción y conversión',
    icon: '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
  },
  {
    title: 'Integración con tu CRM',
    desc: 'Conecta clientes y pedidos con tus herramientas.',
    msg: 'se integre con mi CRM y mis herramientas',
    icon: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  },
];

const waBase = 'https://wa.me/5492665258874?text=';
---

<BaseLayout
  title="Agentes IA para E-commerce — VIVE-IA"
  description="Automatizá tu tienda online con agentes conversacionales. Recuperá carritos, mejorá la atención y vendé más las 24hs."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'Agente IA para E-commerce',
      provider: { '@type': 'Organization', name: 'VIVE-IA', url: 'https://vive-ia.com' },
      description: 'Automatizá tu tienda online con agentes conversacionales. Recuperá carritos abandonados, mejorá la atención y vendé más las 24hs.',
      url: 'https://vive-ia.com/soluciones/ecommerce',
      areaServed: [
        { '@type': 'Country', name: 'Argentina' },
        { '@type': 'Country', name: 'Chile' },
        { '@type': 'Country', name: 'Colombia' },
        { '@type': 'Country', name: 'México' },
        { '@type': 'Country', name: 'Uruguay' },
        { '@type': 'Country', name: 'Perú' },
      ],
      serviceType: 'Automatización con Inteligencia Artificial',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Funciones del agente IA para E-commerce',
        itemListElement: funciones.map((f) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: f.title, description: f.desc },
        })),
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://vive-ia.com' },
        { '@type': 'ListItem', position: 2, name: 'Soluciones', item: 'https://vive-ia.com/soluciones' },
        { '@type': 'ListItem', position: 3, name: 'Agentes para E-commerce', item: 'https://vive-ia.com/soluciones/ecommerce' },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Cómo ayuda un agente IA a recuperar carritos abandonados?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'El agente detecta cuando un cliente deja el carrito sin comprar y envía mensajes automáticos por WhatsApp o Instagram con recordatorios, incentivos personalizados y asistencia para completar la compra, aumentando la tasa de recuperación hasta un 30%.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Con qué plataformas de e-commerce se integra el agente de VIVE-IA?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'El agente de VIVE-IA se integra con Tienda Nube, WooCommerce, Shopify, MercadoShops y otras plataformas populares en LATAM. También se conecta con MercadoPago, WhatsApp Business y los principales canales de comunicación.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Cuánto tiempo tarda la implementación del agente para e-commerce?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'La implementación tarda entre 7 y 15 días hábiles, incluyendo diagnóstico, configuración, entrenamiento del agente con el catálogo y las integraciones necesarias.',
          },
        },
        {
          '@type': 'Question',
          name: '¿El agente puede manejar consultas sobre stock y estado de pedidos?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Sí. El agente se conecta en tiempo real con tu plataforma de e-commerce para responder consultas de stock, estado de pedidos, tiempos de entrega y más, sin intervención humana.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Qué pasa si el agente no sabe responder una pregunta?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'El agente identifica automáticamente cuando una consulta supera su capacidad de respuesta y la deriva a un agente humano con todo el contexto de la conversación, garantizando una experiencia fluida para el cliente.',
          },
        },
      ],
    },
  ]}
>

  <!-- ═══════════════════════════════════════════ -->
  <!-- 1. HERO                                      -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden bg-[#0A0A0F]">
    <!-- Fondo propio: líneas que pasan del caos al orden -->
    <HeroFlow />

    <!-- Velo para que el texto se lea: más oscuro del lado del texto y abajo -->
    <div
      class="absolute inset-0 z-10 pointer-events-none"
      style="background: linear-gradient(90deg, rgba(10,10,15,0.82) 0%, rgba(10,10,15,0.55) 45%, rgba(10,10,15,0.1) 100%), linear-gradient(to bottom, rgba(10,10,15,0) 70%, #0A0A0F 100%);"
    ></div>

    <!-- Luces de color (degradados radiales, sin blur) -->
    <div class="absolute -top-20 right-0 w-[36rem] h-[36rem] rounded-full opacity-20 z-10 pointer-events-none"
         style="background: radial-gradient(circle, rgba(124,58,237,0.6), transparent 65%);"></div>
    <div class="absolute bottom-0 -left-20 w-[28rem] h-[28rem] rounded-full opacity-15 z-10 pointer-events-none"
         style="background: radial-gradient(circle, rgba(6,182,212,0.5), transparent 65%);"></div>

    <!-- Contenido -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-24
                grid lg:grid-cols-[minmax(0,1fr)_auto] gap-12 items-center">
      <div class="max-w-3xl text-left" data-aos="fade-up">
      <!-- Pill badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full
                  bg-white/[0.06] border border-violet-600/30 mb-8">
        <span class="w-2 h-2 rounded-full bg-violet-400 animate-pulse"></span>
        <span class="text-violet-400 text-xs font-bold uppercase tracking-widest">Inteligencia Conversacional</span>
      </div>

      <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] font-bold tracking-tight text-white mb-6 leading-[1.1]">
        Agentes conversacionales para<br />
        <span style="background: linear-gradient(135deg, #A855F7 0%, #06B6D4 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          E-commerce
        </span>
      </h1>

      <p class="text-xl text-slate-400 max-w-2xl mb-6 leading-relaxed">
        Transformá tu tienda online con IA que vende, atiende y fideliza 24/7.
        Reducí el abandono de carritos y escalá tus ventas sin aumentar el equipo.
      </p>

        <div class="flex flex-col sm:flex-row gap-4 mt-4">
          <a
            href="/contacto"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-lg font-semibold text-lg
                   bg-violet-600 hover:bg-violet-500 text-white
                   shadow-[0_0_30px_rgba(124,58,237,0.4)] hover:shadow-[0_0_50px_rgba(124,58,237,0.6)]
                   transition-all duration-300"
          >
            Agendar diagnóstico gratuito
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="https://wa.me/5492665258874"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-lg font-semibold text-lg
                   border border-white/15 bg-white/[0.04] hover:bg-white/[0.08] hover:border-[#25D366]/60 text-white
                   transition-all duration-300"
          >
            <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Escribinos por WhatsApp
          </a>
        </div>

        <!-- Video en celular y tablet: enlace compacto -->
        <HeroVideo
          variant="compact"
          videoId="CGhpnVBpw_8"
          title="La IA no sirve para vender más"
          poster="/images/video-ecommerce.webp"
          label="Mirá el video"
          sublabel="La IA no sirve para vender más"
        />
      </div>

      <!-- Video en escritorio: tarjeta con portada; el reproductor se carga recién al hacer clic -->
      <HeroVideo
        variant="card"
        videoId="CGhpnVBpw_8"
        title="La IA no sirve para vender más"
        poster="/images/video-ecommerce.webp"
        label="Mirá el video"
        sublabel="La IA no sirve para vender más"
      />
    </div>
  </section>

  <VideoDialog />


  <!-- ═══════════════════════════════════════════ -->
  <!-- 2. MÉTRICAS                                  -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="py-14 px-4 sm:px-6 bg-[#0D0D14] border-t border-b border-white/[0.06]">
    <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-10 text-center">
      <div data-aos="fade-up" data-aos-delay="0">
        <div class="text-4xl font-extrabold text-white mb-2">50+</div>
        <p class="text-slate-400 uppercase tracking-widest text-xs font-semibold">Carritos recuperados/mes</p>
      </div>
      <div data-aos="fade-up" data-aos-delay="100">
        <MetricCounter value={1150} prefix="+" suffix="%" label="ROI en implementación" />
      </div>
      <div data-aos="fade-up" data-aos-delay="200">
        <div class="text-4xl font-extrabold text-white mb-2">24/7</div>
        <p class="text-slate-400 uppercase tracking-widest text-xs font-semibold">Disponibilidad garantizada</p>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════ -->
  <!-- 3. PROBLEMAS                                 -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-[#0A0A0F]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16" data-aos="fade-up">
        <SectionBadge text="El problema" />
        <h2 class="text-[clamp(2rem,4vw,3rem)] font-semibold text-white mb-4">
          ¿Tu E-commerce sufre de estos problemas?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {problemas.map((p, i) => (
          <div
            data-aos="fade-up"
            data-aos-delay={String((i % 3) * 100)}
            class="rounded-2xl bg-[#111118] border border-red-900/20
                   hover:border-red-900/40 transition-all duration-300 overflow-hidden"
          >
            <img
              src={p.image} {...imgSize(p.image)}
              alt={p.title}
              class="w-full h-28 object-cover object-center rounded-t-xl"
              loading="lazy"
            />
            <div class="p-6">
              <h3 class="text-white font-semibold text-lg mb-3">{p.title}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{p.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════ -->
  <!-- 4. QUÉ ES UN AGENTE CONVERSACIONAL           -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-[#0D0D14]">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <div data-aos="fade-right">
          <SectionBadge text="La solución" />
          <h2 class="text-[clamp(2rem,4vw,3rem)] font-semibold text-white mb-6">
            ¿Qué es un agente conversacional?
          </h2>
          <p class="text-slate-400 text-lg leading-relaxed mb-8">
            No es un simple chatbot. Es un experto en ventas digital que entiende el contexto,
            conoce tu catálogo y actúa proactivamente para cerrar ventas, tal como lo haría
            tu mejor vendedor.
          </p>

          <ul class="space-y-5">
            {capacidades.map((c, i) => (
              <li class="flex items-start gap-4" data-aos="fade-right" data-aos-delay={String(i * 80)}>
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-violet-600/20 border border-violet-600/40
                             flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <div>
                  <h4 class="text-white font-semibold mb-1">{c.title}</h4>
                  <p class="text-slate-400 text-sm">{c.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Panel decorativo derecha -->
        <div data-aos="fade-left" data-aos-delay="100">
          <div class="relative p-8 rounded-2xl bg-[#111118] border border-white/[0.06]
                      shadow-[0_0_60px_rgba(124,58,237,0.08)]">
            <!-- Chat simulado -->
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-slate-700 flex-shrink-0 flex items-center justify-center text-xs text-slate-300">👤</div>
                <div class="bg-[#1A1A28] rounded-2xl rounded-tl-none px-4 py-3 max-w-xs">
                  <p class="text-slate-300 text-sm">Hola, ¿tienen la zapatilla en talle 42?</p>
                </div>
              </div>
              <div class="flex items-start gap-3 flex-row-reverse">
                <div class="w-8 h-8 rounded-full bg-violet-600/30 flex-shrink-0 flex items-center justify-center text-xs">🤖</div>
                <div class="bg-violet-600/15 border border-violet-600/20 rounded-2xl rounded-tr-none px-4 py-3 max-w-xs">
                  <p class="text-slate-200 text-sm">¡Claro! Tenemos stock en talle 42. También te cuento que hoy tiene 15% off. ¿Te lo reservo? 🎉</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-slate-700 flex-shrink-0 flex items-center justify-center text-xs text-slate-300">👤</div>
                <div class="bg-[#1A1A28] rounded-2xl rounded-tl-none px-4 py-3 max-w-xs">
                  <p class="text-slate-300 text-sm">Sí, perfecto. ¿Cómo pago?</p>
                </div>
              </div>
              <div class="flex items-start gap-3 flex-row-reverse">
                <div class="w-8 h-8 rounded-full bg-violet-600/30 flex-shrink-0 flex items-center justify-center text-xs">🤖</div>
                <div class="bg-violet-600/15 border border-violet-600/20 rounded-2xl rounded-tr-none px-4 py-3 max-w-xs">
                  <p class="text-slate-200 text-sm">Te envío el link de pago ahora mismo 👇</p>
                </div>
              </div>
            </div>
            <!-- Badge IA activa -->
            <div class="absolute -bottom-5 -right-5 p-4 rounded-xl bg-[#1A1A28] border border-violet-600/20 flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-violet-400 animate-pulse"></span>
              <span class="text-slate-300 text-xs font-medium">IA activa 24/7</span>
            </div>
          </div>
        </div>
      </div>
    </div>
