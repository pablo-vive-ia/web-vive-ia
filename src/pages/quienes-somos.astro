---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBadge from '../components/SectionBadge.astro';
import HeroFlow from '../components/HeroFlow.astro';
import VideoDialog from '../components/VideoDialog.astro';

// Manifiesto palabra por palabra: cada palabra se enciende al pasar por la pantalla
// (scroll-driven animations). `hl` = parte destacada con el degradado de la marca.
const manifesto = [
  { text: '“No reemplazamos personas.', hl: false },
  { text: 'Liberamos su potencial.', hl: true },
  { text: 'Nuestra misión es devolverle al humano el tiempo para ser humano, mientras la tecnología se encarga de lo predecible.”', hl: false },
].flatMap((part) => part.text.split(' ').map((word) => ({ word, hl: part.hl })));

// Equipo: con quién habla el cliente y de qué pasos del proceso se ocupa cada uno.
// Las bios son las de siempre (no agregar logros ni cifras que no estén confirmados).
const team = [
  {
    name: 'Luciana Frisardi',
    role: 'Cofundadora · Estrategia & Negocios',
    photo: '/images/luciana-retrato.webp',
    photoSize: { width: 640, height: 800 },
    focus: 'Entiende tu negocio',
    steps: [
      { number: '01', title: 'Diagnóstico', description: 'Entendemos tu flujo actual y detectamos cuellos de botella.' },
      { number: '02', title: 'Orden', description: 'Optimizamos procesos antes de tocar una sola línea de código.' },
    ],
    bio: [
      'Con más de 18 años asesorando empresas en procesos de transformación y crecimiento estratégico, Luciana es la brújula que conecta la tecnología con los objetivos reales de cada negocio. Su experiencia abarca múltiples industrias, desde pymes hasta organizaciones de mayor escala.',
      'Su mirada estratégica garantiza que cada automatización no sea solo eficiente, sino que tenga impacto medible en la operación y en los resultados. Luciana asegura que la IA se implemente con propósito, no por moda.',
    ],
  },
  {
    name: 'Pablo Frisardi',
    role: 'Cofundador · IA & Automatización',
    photo: '/images/pablo-retrato.webp',
    photoSize: { width: 392, height: 490 },
    focus: 'Construye tu sistema',
    steps: [
      { number: '03', title: 'Sistematización', description: 'Creamos la infraestructura robusta que soportará la IA.' },
      { number: '04', title: 'Automatización con IA', description: 'Desplegamos agentes inteligentes que ejecutan y aprenden.' },
    ],
    bio: [
      'Con más de 20 años en tecnología, Pablo es el arquitecto técnico detrás de cada solución de VIVE-IA. Especialista en inteligencia artificial, automatización de procesos e integración de sistemas complejos, ha liderado proyectos de transformación digital en empresas de múltiples industrias.',
      'Su enfoque diferencial radica en traducir la complejidad tecnológica en sistemas simples, robustos y escalables. Para Pablo, la mejor automatización es la que nadie nota porque simplemente funciona — 24 horas al día, todos los días.',
    ],
  },
];

const pillars = [
  { label: 'Propósito', text: 'Que cualquier negocio, del tamaño que sea, pueda automatizar con la eficiencia de las grandes empresas.' },
  { label: 'Misión', text: 'Diseñar e implementar sistemas inteligentes que eliminen el ruido operativo, para que te enfoques en lo que realmente importa.' },
  { label: 'Visión', text: 'Ser referentes en integrar IA de forma ética y eficiente, construyendo un futuro donde el trabajo sea sinónimo de creación.' },
];

const valores = [
  { title: 'Tecnología con propósito', description: 'La innovación solo vale si resuelve un problema real.' },
  { title: 'Orden antes que automatización', description: 'No automatizamos el caos; primero diseñamos el orden.' },
  { title: 'Eficiencia con sentido humano', description: 'Empatía en el diseño, precisión en la ejecución.' },
  { title: 'Impacto real', description: 'Medimos nuestro éxito por los resultados tangibles de nuestros clientes.' },
  { title: 'Evolución constante', description: 'En la frontera de la IA, el aprendizaje nunca se detiene.' },
];

const play = 'M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14z';
---

<BaseLayout
  title="Quiénes Somos — VIVE-IA"
  description="Conocé a Pablo y Luciana Frisardi, fundadores de VIVE-IA. Estrategia, tecnología y propósito para transformar tu negocio."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      name: 'Quiénes Somos — VIVE-IA',
      url: 'https://vive-ia.com/quienes-somos',
      description: 'VIVE-IA es una agencia argentina de automatización con IA fundada por Pablo y Luciana Frisardi. Transformamos negocios de LATAM con tecnología inteligente.',
      inLanguage: 'es',
      about: { '@type': 'Organization', name: 'VIVE-IA', url: 'https://vive-ia.com' },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://vive-ia.com' },
          { '@type': 'ListItem', position: 2, name: 'Quiénes Somos', item: 'https://vive-ia.com/quienes-somos' },
        ],
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Pablo Frisardi',
      image: 'https://vive-ia.com/images/pablo-retrato.webp',
      jobTitle: 'Cofundador y especialista en IA y automatización',
      worksFor: { '@type': 'Organization', name: 'VIVE-IA', url: 'https://vive-ia.com' },
      description: 'Especialista en inteligencia artificial y automatización con más de 20 años de experiencia en tecnología. Cofundador de VIVE-IA, agencia de automatización con IA para LATAM.',
      knowsAbout: ['Inteligencia Artificial', 'Automatización de procesos', 'n8n', 'WhatsApp Business API', 'Desarrollo web'],
      nationality: { '@type': 'Country', name: 'Argentina' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Luciana Frisardi',
      image: 'https://vive-ia.com/images/luciana-retrato.webp',
      jobTitle: 'Cofundadora y asesora empresarial estratégica',
      worksFor: { '@type': 'Organization', name: 'VIVE-IA', url: 'https://vive-ia.com' },
      description: 'Asesora empresarial y estratégica con más de 18 años de experiencia en negocios. Cofundadora de VIVE-IA, especialista en estrategia comercial y crecimiento para empresas de LATAM.',
      knowsAbout: ['Estrategia empresarial', 'Ventas', 'Growth marketing', 'LATAM'],
      nationality: { '@type': 'Country', name: 'Argentina' },
    },
  ]}
>

  <!-- ═══════════════════════════════════════════ -->
  <!-- 1. HERO: las personas primero                -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden bg-[#0A0A0F]">
    <HeroFlow />

    <!-- Velo para que el texto se lea -->
    <div
      class="absolute inset-0 z-10 pointer-events-none"
      style="background: linear-gradient(90deg, rgba(10,10,15,0.85) 0%, rgba(10,10,15,0.6) 50%, rgba(10,10,15,0.25) 100%), linear-gradient(to bottom, rgba(10,10,15,0) 70%, #0A0A0F 100%);"
    ></div>
    <div class="absolute -top-20 right-0 w-[36rem] h-[36rem] rounded-full opacity-20 z-10 pointer-events-none"
         style="background: radial-gradient(circle, rgba(124,58,237,0.6), transparent 65%);"></div>

    <!-- Celular: título, fotos y texto. Escritorio: texto a la izquierda y fotos a la derecha -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-28 pb-20 lg:py-24
                grid gap-x-16 gap-y-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:grid-rows-[auto_1fr] items-center">

      <div class="lg:self-end" data-aos="fade-up">
        <SectionBadge text="Quiénes somos" />
        <h1 class="text-[clamp(2.25rem,4vw,3.4rem)] font-bold text-white leading-[1.08] mt-2">
          Somos Pablo y Luciana.
          <span class="block mt-1"
                style="background: linear-gradient(135deg, #A855F7 0%, #06B6D4 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
            Tecnología y negocio en el mismo equipo.
          </span>
        </h1>
      </div>

      <div class="team-photos grid grid-cols-2 gap-3 sm:gap-5 max-w-[520px] lg:max-w-none lg:flex lg:items-start lg:row-span-2 lg:col-start-2 lg:row-start-1"
           data-aos="fade-left" data-aos-delay="150">
        {[...team].reverse().map((person, i) => (
          <figure class={`relative aspect-[4/5] w-full lg:w-[230px] xl:w-[260px] rounded-2xl overflow-hidden
                          border border-white/10 shadow-[0_0_40px_rgba(124,58,237,0.18)] ${i === 1 ? 'lg:mt-16' : ''}`}>
            <img
              src={person.photo}
              {...person.photoSize}
              alt={`${person.name}, ${person.role.split(' · ')[0]} de VIVE-IA`}
              class="absolute inset-0 w-full h-full object-cover"
              fetchpriority="high"
            />
            <span class="absolute inset-0"
                  style="background: linear-gradient(to top, rgba(10,10,15,0.92) 0%, rgba(10,10,15,0.2) 38%, rgba(10,10,15,0) 60%), linear-gradient(160deg, rgba(124,58,237,0.22) 0%, rgba(124,58,237,0) 45%);"></span>
            <figcaption class="absolute inset-x-0 bottom-0 p-3 sm:p-5">
              <span class="block text-white font-semibold text-sm sm:text-lg leading-tight">{person.name}</span>
              <span class="block text-violet-300 text-xs sm:text-sm">{person.focus}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="lg:self-start" data-aos="fade-up" data-aos-delay="100">
        <p class="text-lg md:text-xl text-slate-300 max-w-xl leading-relaxed">
          Fundamos VIVE-IA para que tu empresa crezca sin caos: primero ordenamos tus procesos
          y después los automatizamos con inteligencia artificial.
        </p>

        <div class="flex flex-wrap gap-x-10 gap-y-4 mt-8">
          <p>
            <span class="block text-3xl font-bold text-white font-display">+20 años</span>
            <span class="block text-slate-400 text-sm">en tecnología · Pablo</span>
          </p>
          <p>
            <span class="block text-3xl font-bold text-white font-display">+18 años</span>
            <span class="block text-slate-400 text-sm">en negocios y estrategia · Luciana</span>
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 mt-10">
          <a
            href="/contacto"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-lg font-semibold text-lg whitespace-nowrap
                   bg-violet-600 hover:bg-violet-500 text-white
                   shadow-[0_0_30px_rgba(124,58,237,0.4)] hover:shadow-[0_0_50px_rgba(124,58,237,0.6)]
                   transition-all duration-300"
          >
            Agendar diagnóstico gratuito
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <button
            type="button"
            data-video-open
            data-video-id="omr91fMMxk4"
            data-video-title="Conocé VIVE-IA"
            class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-lg font-semibold text-lg whitespace-nowrap
                   border border-white/15 bg-white/[0.04] hover:bg-white/[0.08] hover:border-violet-500/60 text-white
                   transition-all duration-300"
          >
            <span class="w-7 h-7 rounded-full bg-violet-600 flex items-center justify-center flex-shrink-0">
              <svg class="w-3.5 h-3.5 text-white translate-x-px" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={play} /></svg>
            </span>
            Conocenos en video
          </button>
        </div>
      </div>
    </div>
  </section>

  <VideoDialog />


  <!-- ═══════════════════════════════════════════ -->
  <!-- 2. MANIFIESTO + SOMOS VIVE-IA                -->
  <!-- ═══════════════════════════════════════════ -->
  <!-- overflow-clip y no overflow-hidden: hidden crea un contenedor de scroll y view() del manifiesto
       quedaría atado a esta sección (que no scrollea) en vez de a la página -->
  <section class="relative py-28 md:py-36 px-4 sm:px-6 overflow-clip" style="background: #070709;">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[900px] rounded-full pointer-events-none"
         style="background: radial-gradient(circle, rgba(124,58,237,0.10), transparent 65%);"></div>

    <div class="relative z-10 max-w-5xl mx-auto">
      <p class="text-violet-400 text-sm font-semibold tracking-widest uppercase mb-8 text-center">Manifiesto VIVE-IA</p>

      <blockquote class="manifesto text-[clamp(1.9rem,4.6vw,3.6rem)] font-semibold text-white leading-[1.15] text-center
                         font-display tracking-[-0.02em]">
        <p>
          {manifesto.map(({ word, hl }) => (
            <><span class={hl ? 'mw mw-hl' : 'mw'}>{word}</span>{' '}</>
          ))}
        </p>
      </blockquote>

      <div class="grid md:grid-cols-2 gap-8 md:gap-12 mt-20 pt-12 border-t border-white/[0.08]" data-aos="fade-up">
        <p class="text-slate-400 text-lg leading-relaxed">
          Nacimos de la convicción de que la inteligencia artificial no es solo una herramienta
          tecnológica, sino un catalizador de libertad creativa. En VIVE-IA, transformamos la
          fricción operativa en fluidez estratégica, permitiendo que las empresas respiren,
          innoven y crezcan sin las ataduras de las tareas repetitivas.
        </p>
        <p class="text-slate-400 text-lg leading-relaxed">
          No llegamos con soluciones predefinidas. Escuchamos, entendemos y diseñamos sistemas
          a medida que resuelven los problemas reales de tu negocio — con tecnología que tiene
          propósito.
        </p>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════ -->
  <!-- 3. EQUIPO: con quién vas a trabajar          -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-[#0A0A0F]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16" data-aos="fade-up">
        <SectionBadge text="Las personas detrás" />
        <h2 class="text-[clamp(2rem,4vw,3rem)] font-semibold text-white mb-4">
          Con quién vas a trabajar
        </h2>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">
          Más de 38 años de experiencia combinada en tecnología y negocios, al servicio de tu crecimiento.
          Cada uno se ocupa de una parte del proceso.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-6">
        {team.map((person, i) => (
          <article
            data-aos="fade-up"
            data-aos-delay={String(i * 120)}
            class="flex flex-col p-7 sm:p-10 rounded-2xl bg-[#111118] border border-white/[0.06]
                   hover:border-violet-600/30 transition-colors duration-300"
          >
            <header class="flex items-center gap-5">
              <img
                src={person.photo}
                {...person.photoSize}
                alt=""
                class="w-20 h-20 rounded-full object-cover object-top ring-2 ring-violet-500/30 flex-shrink-0"
                loading="lazy"
              />
              <div>
                <h3 class="text-white font-bold text-2xl leading-tight">{person.name}</h3>
                <p class="text-violet-400 text-sm font-medium mt-1">{person.role}</p>
              </div>
            </header>

            <p class="text-slate-400 text-xs font-semibold uppercase tracking-widest mt-8 mb-3">
              En tu proyecto · {person.focus.toLowerCase()}
            </p>
            <ul class="grid sm:grid-cols-2 gap-3" role="list">
              {person.steps.map((step) => (
                <li class="rounded-xl border border-violet-600/20 bg-violet-600/[0.06] p-4">
                  <span class="block text-violet-400 text-xs font-bold mb-1">{step.number}</span>
                  <span class="block text-white font-semibold">{step.title}</span>
                  <span class="block text-slate-400 text-sm leading-relaxed mt-1">{step.description}</span>
                </li>
              ))}
            </ul>

            <div class="mt-8 space-y-4">
              {person.bio.map((paragraph) => (
                <p class="text-slate-400 leading-relaxed">{paragraph}</p>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════ -->
  <!-- 4. LO QUE NOS MUEVE: propósito y valores     -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-[#0D0D14]">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16">

      <div data-aos="fade-up">
        <SectionBadge text="Lo que nos mueve" />
        <h2 class="text-[clamp(2rem,4vw,3rem)] font-semibold text-white mb-10">
          Propósito, misión y visión
        </h2>
        <dl class="space-y-8">
          {pillars.map((pillar) => (
            <div class="border-l-2 border-violet-600/50 pl-6">
              <dt class="text-violet-400 text-sm font-semibold uppercase tracking-widest mb-2">{pillar.label}</dt>
              <dd class="text-slate-200 text-lg leading-relaxed">{pillar.text}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div data-aos="fade-up" data-aos-delay="120">
        <SectionBadge text="Lo que nos define" />
        <h2 class="text-[clamp(2rem,4vw,3rem)] font-semibold text-white mb-10">
          Nuestros valores
        </h2>
        <ul class="divide-y divide-white/[0.08] border-y border-white/[0.08]" role="list">
          {valores.map((valor, i) => (
            <li class="flex gap-5 py-5">
              <span class="text-violet-400 font-bold text-sm pt-1 w-6 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-white font-semibold text-lg">{valor.title}</h3>
                <p class="text-slate-400 leading-relaxed mt-1">{valor.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════ -->
  <!-- 5. CTA FINAL                                 -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="relative py-28 px-4 sm:px-6 lg:px-8 overflow-hidden text-center"
           style="background: linear-gradient(135deg, #3b0764 0%, #1e1b4b 40%, #0f172a 100%);">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full pointer-events-none opacity-40"
         style="background: radial-gradient(circle, rgba(124,58,237,0.6), transparent 70%);"></div>

    <div class="relative z-10 max-w-3xl mx-auto" data-aos="fade-up">
      <SectionBadge text="Siguiente paso" />
      <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] font-bold text-white mb-4 mt-2">
        ¿Tu negocio está listo para automatizar?
      </h2>
      <p class="text-slate-300 text-lg mb-10 max-w-xl mx-auto leading-relaxed">
        Agendá una sesión de diagnóstico y descubrí cómo la IA puede transformar
        tu operación diaria.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contacto"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-lg font-semibold text-white
                 bg-violet-600 hover:bg-violet-500
                 shadow-[0_0_20px_rgba(124,58,237,0.4)] hover:shadow-[0_0_30px_rgba(124,58,237,0.6)]
                 transition-all duration-300"
        >
          Agendar diagnóstico gratuito
        </a>
        <a
          href="https://wa.me/5492665258874"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-lg font-semibold text-white
                 bg-[#25D366] hover:bg-[#1ebe5a]
                 transition-all duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-5 h-5" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </section>

<style>
  /* Manifiesto: cada palabra se enciende al pasar por la pantalla, con su propia línea
     de tiempo de vista (corre fuera del hilo principal, a la frecuencia de la pantalla).
     Sin soporte o con movimiento reducido, se ve todo encendido. */
  /* inline-block: cada palabra tiene su propia caja y su propia línea de tiempo
     (en línea, todas toman la misma y se encienden juntas) */
  .mw { display: inline-block; }
  .mw-hl {
    background: linear-gradient(135deg, #A855F7 0%, #06B6D4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  @keyframes mw-on {
    from { opacity: 0.16; }
    to { opacity: 1; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .manifesto .mw { animation: mw-on linear both; }
