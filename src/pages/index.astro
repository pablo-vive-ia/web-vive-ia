<BaseLayout
  title="VIVE-IA — Automatizá tu negocio con Inteligencia Artificial"
  description="Ordenamos, estructuramos y automatizamos tus procesos para que tu empresa crezca sin caos. Agencia IA en Argentina."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'VIVE-IA — Automatizá tu negocio con Inteligencia Artificial',
      url: 'https://vive-ia.com',
      description: 'Ordenamos, estructuramos y automatizamos tus procesos para que tu empresa crezca sin caos. Agencia de automatización con IA en Argentina.',
      inLanguage: 'es',
      isPartOf: { '@type': 'WebSite', url: 'https://vive-ia.com', name: 'VIVE-IA' },
      about: { '@type': 'Organization', name: 'VIVE-IA', url: 'https://vive-ia.com' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: 'VIVE-IA — Agencia de Automatización con Inteligencia Artificial',
      description: 'Conocé cómo VIVE-IA transforma negocios en LATAM con automatización inteligente e inteligencia artificial.',
      thumbnailUrl: 'https://vive-ia.com/images/video-presentacion.webp',
      uploadDate: '2024-06-01',
      contentUrl: 'https://www.youtube.com/watch?v=omr91fMMxk4',
      embedUrl: 'https://www.youtube.com/embed/omr91fMMxk4',
      publisher: { '@type': 'Organization', name: 'VIVE-IA', url: 'https://vive-ia.com' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Qué es VIVE-IA?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'VIVE-IA es una agencia argentina especializada en automatización de procesos con inteligencia artificial. Ayudamos a empresas de e-commerce, mentores y marcas personales a ordenar, sistematizar y automatizar sus procesos para crecer sin caos.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Qué tipos de empresas pueden contratar los servicios de VIVE-IA?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'VIVE-IA trabaja principalmente con tiendas de e-commerce (Tienda Nube, WooCommerce, Shopify), mentores y marcas personales (cursos, coaching), e inmobiliarias. Atendemos empresas de toda LATAM.',
          },
        },
        {
          '@type': 'Question',
          name: '¿En qué países opera VIVE-IA?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'VIVE-IA opera en toda Latinoamérica: Argentina, Chile, Colombia, México, Uruguay, Perú y más. La sede principal está en Argentina.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Cuánto tiempo tarda implementar un agente de IA?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'La implementación de un agente IA para e-commerce o mentores tarda entre 7 y 15 días hábiles, dependiendo de la complejidad del negocio y las integraciones necesarias.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Es necesario tener conocimientos técnicos para trabajar con VIVE-IA?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. VIVE-IA se encarga de todo el proceso técnico: diagnóstico, diseño, implementación y seguimiento. El cliente solo necesita participar en las reuniones de diagnóstico y aprobación.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Con qué plataformas trabaja VIVE-IA?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'VIVE-IA integra WhatsApp Business, Instagram, Facebook Messenger, Tienda Nube, WooCommerce, Shopify, MercadoPago, Google Sheets, Notion, y muchas herramientas más según la necesidad del cliente.',
          },
        },
      ],
    },
  ]}
