# Variables de entorno — VIVE-IA Web
# Copiar este archivo como .env y completar los valores

# ⚠️ Astro embebe en el bundle del cliente cualquier variable con prefijo
# PUBLIC_ que se referencie en código — queda visible en el HTML/JS público.
# Nunca uses PUBLIC_ para una API key que deba mantenerse secreta.

# Gemini API Key — actualmente SIN USO en el código (no hay ningún
# import.meta.env.PUBLIC_GEMINI_API_KEY en src/). Si se retoma la integración
# con Gemini, la llamada debe hacerse server-side (ej. vía n8n), nunca desde
# el cliente con esta key. Dejar vacía si no se usa.
PUBLIC_GEMINI_API_KEY=
